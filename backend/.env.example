# DeepSeek LLM API Configuration
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1

# Volcengine STT API Configuration (火山引擎语音识别)
STT_ACCESS_KEY=your_volcengine_access_key_here
STT_SECRET_KEY=your_volcengine_secret_key_here
STT_APP_ID=your_volcengine_app_id_here

# Server URL for audio file access (public IP/domain)
SERVER_URL=http://your-server-ip:8000/uploads

# Database Configuration
# For local development: sqlite:///./echomemo.db
# For production: postgresql://user:password@db:5432/echomemo
DATABASE_URL=sqlite:///./echomemo.db

# Security
SECRET_KEY=your_random_secret_key_here

# Optional: Database credentials for PostgreSQL
POSTGRES_USER=echouser
POSTGRES_PASSWORD=echopass
POSTGRES_DB=echomemo
